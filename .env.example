# Copy to .env and replace every CHANGE_ME value before starting Compose.
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'

# Required by every Compose deployment.
REMEM_SERVER_API_KEY=CHANGE_ME_REMEM_API_KEY

# Required by docker-compose.business.yml and its development override.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
BACKOFFICE_POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
BACKOFFICE_JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS
BACKOFFICE_ADMIN_EMAIL=admin@mycompany.com
BACKOFFICE_ADMIN_PASSWORD=CHANGE_ME_BACKOFFICE_ADMIN_PASSWORD

# Where Remem keeps its corpus on the host. Every production Compose deployment
# bind-mounts this directory at /var/lib/remem inside the container, so the data
# is visible to ordinary host tools and is not removed by `docker compose down -v`.
#
# A relative path resolves from the Compose project directory -- the directory
# holding the compose file, unless `docker compose` was given --project-directory.
# An absolute path is used exactly as written, which is what a managed server
# usually wants:
#   REMEM_DATA_DIR=/srv/remem/data
#
# The directory must be writable by the container's user, uid 10001. Compose
# creates a missing bind-mount source as root, which the server cannot write to,
# so create it yourself first:
#   mkdir -p ./remem-data && sudo chown 10001:10001 ./remem-data
#
# Migrating an existing deployment off the old `remem-data` named volume:
# see docs/DEPLOYMENT.md. Do not point this at a directory holding another
# Pebble database.
REMEM_DATA_DIR=./remem-data

# Optional port and service settings. Defaults match the Compose files.
REMEM_HTTP_PORT=4545
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
BACKOFFICE_API_PORT=8002
BACKOFFICE_PORT=3000
BACKOFFICE_BIND=127.0.0.1
REMEM_TENANT=default
BACKOFFICE_MAX_SCAN=10000
BACKOFFICE_CORS_ORIGINS=http://localhost:3000
